# Скопируйте в .env (файл в .gitignore) или запустите up.sh: он создаст .env сам.
SUPERSET_SECRET_KEY=замените-на-случайную-строку
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
# Как Superset видит PostgreSQL организаторов (порт из model/docker-compose.local.yml)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5433
POSTGRES_USER=hack
POSTGRES_PASSWORD=hack
POSTGRES_DB=marketplace
